# ~/.bashrc.toolbox — shell configuration for the interactive dev profile.
# Faithful snapshot from a development harness (config/bashrc.template).
# Sourced from ~/.bashrc when SA_PROFILE=interactive is active.
# NOT loaded in the autonomous agent profile.

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# /usr/local/bin: RHEL login shells omit this; claude and openshell are installed there.
export PATH="/usr/local/bin:$PATH"

# Source additional configs from .bashrc.d
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        [ -f "$rc" ] && . "$rc"
    done
fi
unset rc

# Go (SA_PROFILE=interactive only — Go installed by install-languages.sh)
if [ -d /usr/local/go/bin ]; then
    export PATH=$PATH:/usr/local/go/bin
    export GOPATH=$HOME/go
    export PATH=$PATH:$GOPATH/bin
fi

# Rust (SA_PROFILE=interactive only — Rust installed by install-languages.sh)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# OpenShift project in prompt (SA_PROFILE=interactive; oc installed by install-k8s-tools.sh)
if command -v oc &>/dev/null; then
    function __oc_ps1() {
        local project
        project=$(oc project -q 2>/dev/null)
        [ -n "$project" ] && echo " ($project)"
    }
    export PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\[\033[01;33m\]$(__oc_ps1)\[\033[00m\]$ '
fi

# SSH Agent
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

# Secrets: pulled from AWS Secrets Manager via fetch-secrets.sh; never committed.
#   export SA_SECRET_ID=my-agent/runner-keys && ~/rhel-bootstrap/scripts/fetch-secrets.sh
# That writes ~/.secrets.env (mode 600); sourced here if present.
[[ -f ~/.secrets.env ]] && source ~/.secrets.env

# Aliases
[[ -f ~/.config/toolbox/aliases.sh ]] && source ~/.config/toolbox/aliases.sh
