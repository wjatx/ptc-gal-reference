# Containerfile.broker — the restricted-MCP example's CONSUMER broker image.
#
# The consumer-image-layer pattern (docs/broker-image-cutover.md): the agent-
# agnostic base broker image + this consumer's files, nothing else. What this
# layer adds:
#
#   * the `mcp` python SDK — the base image deliberately ships SDK-free (the
#     extra is optional; base imports stay lazy), so the ONE consumer that hosts
#     an MCP server installs it. It comes from requirements/runtime.txt, the
#     hash-checked lock of pyproject's `aws` and `mcp` extras: see below.
#   * the example package itself: the missileer server (server.py, spawned as a
#     stdio CHILD of the broker task — no new external service) and the
#     manifest, whose mcp_servers.ledger spawn config is what build_runtime
#     constructs the connector from natively (no provider class).
#
# Build from the safe-agents REPO ROOT with the base image tag as BASE_IMAGE
# (mirror a consumer's build-broker-image.sh; no default — a build without it
# must fail rather than pin a stale digest):
#
#   podman build --platform linux/arm64 -f examples/restricted_mcp_server/Containerfile.broker \
#     --build-arg BASE_IMAGE=<base broker image> -t <consumer tag> .
#
# No ENTRYPOINT/CMD override — the base broker server entrypoint is inherited.
# No baked BROKER_MANIFEST — the task definition injects
# BROKER_MANIFEST=/app/examples/restricted_mcp_server/manifest.yaml (an unset one
# fails loudly at boot).
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# The base image ends on `USER broker`; step up only to install + stage, then drop.
USER root
# The `mcp` SDK installs from requirements/runtime.txt, the hash-checked lock of
# pyproject's `aws` and `mcp` extras (CONTRIBUTING.md, "The lock files"). Every
# entry is an exact version with the hashes of its published files, and
# --require-hashes makes pip refuse a file whose hash is not listed. The lock
# repeats the packages the base image installed from requirements/aws.txt, so
# while the two locks are regenerated together this step adds the `mcp` closure
# and leaves the rest as it is.
#
# Why a lock and not a range. This line was once `mcp>=1.9`, which resolved the
# newest release at every build, so the image moved while its tag stayed the
# same. That is the dependency twin of the mutable-tag trap the cluster arm
# already documents. It fired on 2026-07-28: `mcp` 2.0.0 removed
# `mcp.server.fastmcp` (the package now exposes `mcp.server.mcpserver.MCPServer`),
# server.py failed to import, and the stdio child died at `initialize()` with
# `MCPError: Connection closed`, a transport-shaped error for a packaging cause,
# in a leg whose actual subject was the audit tape. Nothing in the repo had
# changed; the internet had.
#
# The `<2` ceiling in pyproject's `mcp` extra dates from that day and stays until
# server.py is migrated to the 2.x API. This file once repeated the range, and the
# two copies drifted (1.9 here, 1.25 there) while a comment claimed they matched.
# The lock is compiled from the extra, so the range is now written in one place.
COPY requirements/runtime.txt ./requirements/
RUN pip install --no-cache-dir --require-hashes -r requirements/runtime.txt
COPY --chown=broker:broker examples/restricted_mcp_server/server.py \
     examples/restricted_mcp_server/manifest.yaml \
     /app/examples/restricted_mcp_server/
USER broker
