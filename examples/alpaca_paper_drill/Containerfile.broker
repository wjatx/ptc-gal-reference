# Containerfile.broker — the MCP-brokerage floor-drill CONSUMER broker image.
#
# The consumer-image-layer pattern (docs/broker-image-cutover.md): the agent-
# agnostic base broker image + this drill's files, nothing else. One image
# carries BOTH drill examples (the toy missileer server and this Alpaca-paper
# manifest); the task definition's BROKER_MANIFEST picks which one boots.
# What this layer adds:
#
#   * the `mcp` python SDK — the base image deliberately ships SDK-free. It
#     installs from requirements/runtime.txt, the hash-checked lock of
#     pyproject's `aws` and `mcp` extras.
#   * the PINNED alpaca-mcp-server, in its own virtualenv at
#     /opt/alpaca-mcp-server, installed from the hash-checked lock
#     requirements/alpaca-mcp-server.txt. The manifest spawns that virtualenv's
#     console script by absolute path, so a spawn resolves nothing and downloads
#     nothing. The version is set in requirements/alpaca-mcp-server.in, and a
#     bump there is a re-vet trigger by design (admitted tools drift-quarantine).
#   * both example packages' files (toy server.py + the two manifests).
#
# This image used to install an unpinned `uv`, and the manifest spawned
# `uvx alpaca-mcp-server==2.1.1` from a pre-warmed cache. That pinned the server's
# own version and nothing else: its dependencies resolved fresh at every build,
# and no file was checked against a hash.
#
# Build from the safe-agents REPO ROOT with the base image tag as BASE_IMAGE
# (mirror a consumer's build-broker-image.sh; no default — a build without it
# must fail rather than pin a stale digest):
#
#   podman build --platform linux/arm64 -f examples/alpaca_paper_drill/Containerfile.broker \
#     --build-arg BASE_IMAGE=<base broker image> -t <consumer tag> .
#
# No ENTRYPOINT/CMD override — the base broker server entrypoint is inherited.
# No baked BROKER_MANIFEST — the task definition injects
# BROKER_MANIFEST=/app/examples/alpaca_paper_drill/manifest.yaml (an unset one
# fails loudly at boot).
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# The base image ends on `USER broker`; step up only to install + stage, then drop.
USER root
# The broker's own `mcp` SDK, from the lock, as in
# examples/restricted_mcp_server/Containerfile.broker. That file records why the
# `mcp` extra carries a `<2` ceiling: `mcp` 2.0.0 removed `mcp.server.fastmcp`,
# and this image stages that same server.py.
COPY requirements/runtime.txt requirements/alpaca-mcp-server.txt ./requirements/
RUN pip install --no-cache-dir --require-hashes -r requirements/runtime.txt
# The vendor server gets a virtualenv of its own. Its lock pins `mcp` 2.x, the
# broker's lock holds `mcp` below 2, and one site-packages cannot hold both. The
# virtualenv is created by root and never chown'd, so the runtime user (and an
# arbitrary OpenShift UID) can read and execute the server and cannot rewrite it,
# the same posture the base image keeps for /app. The path is repeated in
# manifest.yaml (mcp_servers.alpaca.command); move them together.
RUN python -m venv /opt/alpaca-mcp-server \
    && /opt/alpaca-mcp-server/bin/python -m pip install --no-cache-dir --require-hashes \
         -r requirements/alpaca-mcp-server.txt
COPY --chown=broker:broker examples/restricted_mcp_server/server.py \
     examples/restricted_mcp_server/manifest.yaml \
     /app/examples/restricted_mcp_server/
COPY --chown=broker:broker examples/alpaca_paper_drill/manifest.yaml \
     /app/examples/alpaca_paper_drill/
USER broker
