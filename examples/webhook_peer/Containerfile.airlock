# webhook-peer/Containerfile.airlock — a consumer airlock image (FICTIONAL example).
#
# The pattern a real consumer follows: FROM the base channels-airlock image, COPY in
# your own ChannelsManifest, and point the handler at it. No base source is modified;
# the manifest is the entire per-consumer surface.
#
# Build (after building the base image and passing its tag as AIRLOCK_BASE_IMAGE):
#   podman build --platform linux/arm64 \
#     --build-arg AIRLOCK_BASE_IMAGE=safe-agents-channels-airlock:dev \
#     -t webhook-peer-airlock:dev \
#     -f examples/webhook_peer/Containerfile.airlock examples/webhook_peer
ARG AIRLOCK_BASE_IMAGE
FROM ${AIRLOCK_BASE_IMAGE}

# Which manifest variant to ship: the default (screen OFF) or, e.g.,
# --build-arg MANIFEST_FILE=channels-manifest-screened.yaml for the screened one.
ARG MANIFEST_FILE=channels-manifest.yaml
COPY ${MANIFEST_FILE} /var/task/channels-manifest.yaml
ENV CHANNELS_MANIFEST=/var/task/channels-manifest.yaml
